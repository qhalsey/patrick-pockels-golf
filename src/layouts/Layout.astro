---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Patrick Pockels Golf — Private Instruction at Meadowlark Golf Course, Huntington Beach',
  description = 'Private golf lessons with Patrick Pockels at Meadowlark Golf Course in Huntington Beach, CA. 20+ years competitive play, 5+ years coaching. Book a lesson today.',
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: 'Patrick Pockels Golf',
  description: 'Private golf instruction at Meadowlark Golf Course.',
  url: 'https://patrickpockelsgolf.com',
  telephone: '+1-714-591-3924',
  email: 'patrickpockelsgolf@gmail.com',
  priceRange: '$150 - $1000',
  image: 'https://patrickpockelsgolf.com/og-image.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Meadowlark Golf Course',
    addressLocality: 'Huntington Beach',
    addressRegion: 'CA',
    postalCode: '92649',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 33.7136,
    longitude: -118.0511,
  },
  sport: 'Golf',
  founder: {
    '@type': 'Person',
    name: 'Patrick Pockels',
  },
  makesOffer: [
    {
      '@type': 'Offer',
      name: 'Single 60-Minute Lesson',
      price: '150',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: '5-Lesson Pack (one free)',
      price: '750',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: '10-Lesson Pack',
      price: '1000',
      priceCurrency: 'USD',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="Patrick Pockels Golf" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} is:inline />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <slot />
  </body>
</html>
