---
const services = [
  {
    name: 'Meadowlark Range',
    tagline: 'Dialed-in range work outdoors at Meadowlark Golf Course.',
    price: '$100',
    suffix: '/ hour',
    bullets: [
      '60-minute private lesson',
      'Outdoors at Meadowlark Golf Course',
      'Full-swing, short game, or putting',
      'Video feedback on request',
    ],
    cta: 'Book a range lesson',
    badge: 'Start here',
    highlight: true,
    serviceKey: 'range',
  },
  {
    name: 'Simulator',
    tagline: 'Indoor, weather-proof, with launch data on every swing.',
    price: '$130',
    suffix: '/ hour',
    bullets: [
      '60-minute private lesson',
      'Indoor, climate-controlled bay',
      'Launch-monitor data every swing — spin, apex, carry, total',
      'Full-swing or short game work',
    ],
    cta: 'Book a simulator lesson',
    badge: '',
    highlight: false,
    serviceKey: 'sim',
  },
  {
    name: 'On-Course 9-Hole',
    tagline: 'Take the work to the course — strategy under real conditions.',
    price: '$150',
    suffix: '/ 9 holes',
    bullets: [
      'Playing lesson over 9 holes',
      'About 2 hours on the course',
      'Shot-by-shot strategy, tee to green',
      'Course management & smarter decisions',
    ],
    cta: 'Book the 9-hole lesson',
    badge: '',
    highlight: false,
    serviceKey: 'on-course',
  },
];
---

<section id="services" class="py-24 bg-gray-50 border-y border-gray-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl">
      <p class="uppercase tracking-[0.2em] text-xs text-brand-800 mb-4">Lessons &amp; Pricing</p>
      <h2 class="text-4xl md:text-5xl font-semibold tracking-tight text-gray-900">
        Pick the lesson that fits your game.
      </h2>
      <p class="mt-4 text-gray-600">
        Three ways to work with Patrick — dialed-in range sessions, data-rich simulator lessons, and
        on-course playing lessons — all one-on-one and built around your game. Every spot is in
        Huntington Beach. Pick what fits, then grab a time.
      </p>
    </div>

    <div class="mt-14 grid md:grid-cols-3 gap-6">
      {services.map((svc) => (
        <div
          class:list={[
            'rounded-2xl p-8 flex flex-col relative',
            svc.highlight
              ? 'bg-brand-800 text-white shadow-xl ring-1 ring-brand-900'
              : 'bg-white border border-gray-200',
          ]}
        >
          {svc.badge && (
            <span class="absolute -top-3 right-6 bg-brand-300 text-brand-900 text-xs font-semibold px-3 py-1 rounded-full">
              {svc.badge}
            </span>
          )}
          <h3 class:list={['text-lg font-semibold', svc.highlight ? 'text-white' : 'text-gray-900']}>
            {svc.name}
          </h3>
          <p class:list={['mt-2 text-sm', svc.highlight ? 'text-brand-100' : 'text-gray-600']}>
            {svc.tagline}
          </p>
          <div class="mt-6">
            <span class:list={['text-4xl font-semibold', svc.highlight ? 'text-white' : 'text-gray-900']}>
              {svc.price}
            </span>
            <span class:list={[svc.highlight ? 'text-brand-200' : 'text-gray-500']}> {svc.suffix}</span>
          </div>
          <ul
            class:list={[
              'mt-6 space-y-2 text-sm flex-1',
              svc.highlight ? 'text-brand-50' : 'text-gray-700',
            ]}
          >
            {svc.bullets.map((b) => <li>• {b}</li>)}
          </ul>
          <a
            href="#book"
            data-service={svc.serviceKey}
            data-booking-trigger
            class:list={[
              'mt-8 inline-flex justify-center items-center px-5 py-3 rounded-md text-sm font-medium transition',
              svc.highlight
                ? 'bg-white text-brand-800 hover:bg-brand-50'
                : 'bg-gray-900 text-white hover:bg-black',
            ]}
          >
            {svc.cta}
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-gray-600">
      Buying a block of lessons? <strong class="text-gray-900">Multi-lesson packages are coming soon</strong> —
      ask Patrick about current options when you book.
    </p>
  </div>
</section>
