---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-teeing-off.jpg';
---

<section id="top" class="relative min-h-[92vh] flex items-center pt-16">
  <div class="absolute inset-0 -z-10">
    <Image
      src={heroImg}
      alt="Patrick Pockels teeing off at a Pro-Am tournament — rolling hills behind, Martin Gilbert and Insights branded sign boards in the foreground"
      class="w-full h-full object-cover object-center"
      widths={[640, 960, 1280, 1365]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/20"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-24 text-white">
    <p class="uppercase tracking-[0.2em] text-xs text-brand-300 mb-4">Private Golf Instruction</p>
    <h1 class="text-5xl md:text-7xl font-semibold leading-tight tracking-tight max-w-3xl">
      Lower scores.<br />Built shot by shot.
    </h1>
    <p class="mt-6 text-lg md:text-xl text-gray-200 max-w-xl">
      One-on-one coaching with Patrick Pockels at Meadowlark Golf Course in Huntington Beach.
      For beginners through single-digit handicaps.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="#book"
        class="inline-flex items-center px-6 py-3 rounded-md bg-brand-800 text-white font-medium hover:bg-brand-900 transition shadow-lg shadow-brand-900/30"
      >
        Book a Lesson
      </a>
      <a
        href="#about"
        class="inline-flex items-center px-6 py-3 rounded-md bg-white/10 backdrop-blur border border-white/20 text-white font-medium hover:bg-white/20 transition"
      >
        Meet Patrick
      </a>
    </div>

    <div class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-gray-200">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-300" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 15l-5.878 3.09 1.123-6.545L.49 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.755 4.635 1.123 6.545z" />
        </svg>
        <span>5+ years coaching</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-300" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 15l-5.878 3.09 1.123-6.545L.49 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.755 4.635 1.123 6.545z" />
        </svg>
        <span>20+ years competitive play</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-300" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 15l-5.878 3.09 1.123-6.545L.49 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.755 4.635 1.123 6.545z" />
        </svg>
        <span>Valero PGA &middot; SoCal Open '22</span>
      </div>
    </div>
  </div>
</section>
