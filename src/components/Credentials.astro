---
import { Image } from 'astro:assets';
import valeroImg from '../assets/credential-valero.jpg';
import trophyImg from '../assets/credential-trophy.jpg';
import familyImg from '../assets/credential-family.jpg';

const tiles = [
  {
    img: valeroImg,
    alt: 'Patrick Pockels with his caddy at the Valero Texas Open. POCKELS name plate visible at the tee.',
    title: 'Valero Texas Open',
    caption:
      'Earned tee time at the Valero Texas Open in San Antonio — a PGA Tour stop with a competitive history reaching back more than a century.',
  },
  {
    img: trophyImg,
    alt: 'Patrick Pockels holding the 59th SoCal Open trophy in front of the championship signage',
    title: '59th SoCal Open Champion',
    caption:
      'Won the 59th Southern California Open Championship in 2022 — one of the region\'s longest-running pro/am fields and a serious test of tournament play.',
  },
  {
    img: familyImg,
    alt: 'Patrick Pockels celebrating with family on the green after a tournament win',
    title: 'Sharing the win',
    caption:
      'Celebrating with family on the green right after the SoCal Open victory. The behind-the-scenes side of a long competitive season.',
  },
];
---

<section id="credentials" class="py-20 bg-gradient-to-b from-white to-gray-50 border-t border-gray-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-12">
      <p class="uppercase tracking-[0.2em] text-xs text-brand-800 mb-4">Tournament Play</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-gray-900">
        Coached by someone who's been in it.
      </h2>
      <p class="mt-4 text-gray-600">
        The instruction comes from someone with skin in the game at the highest amateur and pro-am
        levels. That tournament pressure is what shapes the lessons.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {tiles.map((tile) => (
        <figure class="group">
          <div class="aspect-[4/5] rounded-xl overflow-hidden bg-gray-100 shadow-md ring-1 ring-gray-200">
            <Image
              src={tile.img}
              alt={tile.alt}
              class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-4">
            <div class="text-sm font-semibold text-gray-900">{tile.title}</div>
            <p class="text-sm text-gray-600 mt-1.5 leading-relaxed">{tile.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
