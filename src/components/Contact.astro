---

<section id="contact" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16">
    <div>
      <p class="uppercase tracking-[0.2em] text-xs text-brand-800 mb-4">Contact</p>
      <h2 class="text-4xl md:text-5xl font-semibold tracking-tight text-gray-900">
        Questions before you book?
      </h2>
      <p class="mt-4 text-gray-600">
        Patrick answers every message personally. Reach out about lesson formats, gift packages, group
        instruction, or anything else.
      </p>
    </div>

    <div class="space-y-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-md bg-brand-100 text-brand-800 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <div class="text-sm text-gray-500">Email</div>
          <a href="mailto:patrickpockelsgolf@gmail.com" class="text-gray-900 font-medium hover:text-brand-800">
            patrickpockelsgolf@gmail.com
          </a>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-md bg-brand-100 text-brand-800 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.79a2 2 0 01-.5 1.86L8.09 10.91a11.05 11.05 0 005 5l1.745-1.33a2 2 0 011.86-.5l2.79.7A2 2 0 0121 16.72V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <div>
          <div class="text-sm text-gray-500">Phone / Text</div>
          <a href="tel:+17145913924" class="text-gray-900 font-medium hover:text-brand-800">
            (714) 591-3924
          </a>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-md bg-brand-100 text-brand-800 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div>
          <div class="text-sm text-gray-500">Where</div>
          <div class="text-gray-900 font-medium">
            Huntington Beach, CA
          </div>
          <div class="text-sm text-gray-600 mt-1">
            Lessons run at <strong>Meadowlark Golf Course</strong> (outdoors) or in Patrick's
            <strong>indoor simulator bay</strong>, depending on the time slot.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
